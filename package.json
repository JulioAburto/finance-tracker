{
  "name": "finance-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "dev:https": "next dev --webpack --experimental-https",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local src/lib/db/seed.ts",
    "db:add-default-categories": "pwsh -NoProfile -File scripts/database/add-default-categories-safe.ps1 -Execute",
    "db:add-apolo-category": "pwsh -NoProfile -File scripts/database/add-apolo-category-safe.ps1 -Execute",
    "db:update-august-2026-category-budgets": "pwsh -NoProfile -File scripts/database/update-august-2026-category-budgets-safe.ps1 -Execute",
    "auth:create-user": "tsx --env-file=.env.local src/lib/auth/create-user.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.1.1",
    "@mui/material-nextjs": "^9.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.9",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
